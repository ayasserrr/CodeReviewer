#=================================
# Testing environment defaults — committed on purpose.
#=================================
# Every value here is a dummy placeholder, never a real credential. The full
# test suite mocks the database layer (repositories are patched with
# MagicMock/AsyncMock in every test) and never opens a real Postgres
# connection or calls a real LLM provider — but `config.settings` is
# constructed eagerly at import time by several modules, so pydantic still
# needs *something* non-empty for every required field, or import itself
# fails before a single test runs. This file exists so `uv run pytest` and
# CI (see .github/workflows/ci.yml) work with zero secrets configured.
#
# tests/conftest.py defaults APP_ENV to "testing" (only if not already set),
# which is what makes pydantic-settings merge this file in. Override with a
# real APP_ENV (e.g. `APP_ENV=development uv run pytest`) to run against a
# real local Postgres instead.
APP_ENV = testing
APP_NAME = "CodeReviewer"
VERSION = "0.0.0-test"

POSTGRES_HOST=localhost
POSTGRES_DB=codereviewer_test
POSTGRES_USER=test
POSTGRES_PORT=5432
POSTGRES_PASSWORD=test-not-a-real-password

# Any 32+ char string satisfies JWT_SECRET_KEY's validator; never use this
# value outside tests.
JWT_SECRET_KEY=test-secret-key-not-for-production-use-only-in-ci-builds
