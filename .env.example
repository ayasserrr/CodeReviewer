#=================================
# Application Environment Configuration
#=================================
# APP_ENV selects which .env.<APP_ENV> file gets merged on top of this one
# (set it as a real environment variable on the machine/process, e.g.
# `set APP_ENV=production`). It defaults to "development" when unset.
# One of: development | staging | production | testing
APP_ENV = development
APP_NAME = "CodeReviewer"
VERSION = "1.0.0"
# DEBUG, LOG_LEVEL and LOG_RENDERER fall back to per-environment defaults
# (see ENV_DEFAULTS in src/config/settings.py) when left unset here.
API_VERSION = "/api/v1"
DEBUG = true
# PROJECT_ROOT defaults to the repository root and normally does not need to
# be set manually. Override only if you need to point at a different path.
# PROJECT_ROOT = E:\path\to\CodeReviewer

#=================================
# Logging Configuration
#=================================
LOG_LEVEL = "DEBUG"
LOG_DIR = "storage/logs"
# One of: console | json
LOG_RENDERER = "console"
LOG_MAX_BYTES = 10485760
LOG_BACKUP_COUNT = 10

# ==================================================
# Database (PostgreSQL) Settings
# ==================================================
POSTGRES_HOST=localhost                # Database host
POSTGRES_DB=CodeReviewer        # Database name
POSTGRES_USER=myuser            # Database username
POSTGRES_PORT=5432              # Database port
POSTGRES_PASSWORD=mypassword    # Database password

# Connection pooling settings
POSTGRES_POOL_SIZE=5            # Base number of persistent DB connections
POSTGRES_MAX_OVERFLOW=10        # Extra connections allowed above pool size

# ==================================================
# JWT / Auth Settings
# ==================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never reuse the same key across environments.
JWT_SECRET_KEY=replace-with-a-generated-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================================================
# Repository Ingestion Settings
# ==================================================
CLONED_REPOS_DIR=cloned_repos
GIT_CLONE_TIMEOUT_SECONDS=300
GITLAB_API_TIMEOUT_SECONDS=15
MIN_FREE_DISK_MB=500

# ==================================================
# Repository Discovery Settings
# ==================================================
# Engine versions are part of the per-commit cache keys and are bumped in code
# (src/config/settings.py) whenever the logic changes — only pin them to force a value.
# DISCOVERY_ENGINE_VERSION=1.0.2
DISCOVERY_SCHEMA_VERSION=1.0.0
DISCOVERY_TRAVERSAL_TIMEOUT_SECONDS=30.0
DISCOVERY_AST_PER_FILE_TIMEOUT_MS=1000
DISCOVERY_TOTAL_TIMEOUT_SECONDS=120.0
DISCOVERY_MAX_AST_FILE_SIZE_MB=2.0

# ==================================================
# Static Analysis Settings (Track A — structural tools: ruff, pyright,
# radon, vulture, lizard, jscpd. Requires these CLI tools to be installed —
# see pyproject.toml's "analysis-tools" dependency group. Every tool scans
# an explicit file list built from Discovery's manifest, not "." with its
# own exclude flags — there is no separate excluded-dirs setting here by
# design, since Discovery already decided what counts as a real source file.)
# ==================================================
ANALYSIS_TIMEOUT_SECONDS=60
# RUFF_CONFIG_PATH defaults to the bundled src/assets/ruff.toml (same
# bundled-asset pattern as gitleaks), so every scanned repo gets a
# consistent ruleset. Only passed to ruff when the file actually exists;
# override to point at a different config, or set to a nonexistent path to
# fall back to each scanned repo auto-discovering its own config.
# RUFF_CONFIG_PATH=
# PYRIGHT_CONFIG_PATH defaults to the bundled src/assets/pyrightconfig.json,
# same reasoning as RUFF_CONFIG_PATH above.
# PYRIGHT_CONFIG_PATH=
# SEMGREP_CONFIG defaults to the bundled, project-owned rules in
# src/assets/semgrep/ so scans run offline and deterministically. Set it to
# "auto" or a registry pack (e.g. "p/python") to download rules from
# semgrep.dev on every run instead (requires network access).
# SEMGREP_CONFIG=
RADON_COMPLEXITY_RANKS_TO_IGNORE=A,B
RADON_MI_RANKS_TO_IGNORE=A
LIZARD_CCN_THRESHOLD=10
LIZARD_CCN_ERROR_THRESHOLD=20

# ==================================================
# Security Engine Settings (Track B — concurrent security tools: pip-audit,
# semgrep, bandit, gitleaks. gitleaks resolves from src/assets/gitleaks[.exe]
# first, falling back to PATH.)
# ==================================================
SECURITY_TOOL_TIMEOUT=300
SECURITY_MAX_WORKERS=4

# ==================================================
# LLM Provider (Deep Review agents)
# ==================================================
# Never commit real keys — put them in your local .env (git-ignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==================================================
# Deep Review Settings (deepagents multi-agent code review)
# ==================================================
DEEP_REVIEW_ENABLED=true
# DEEP_REVIEW_CONFIG_PATH defaults to the bundled src/assets/review_config.toml
# (categories, security KPIs, static-tool ownership). Edit that file to tune
# what the review looks for — its hash is part of the review cache key.
# DEEP_REVIEW_CONFIG_PATH=
# DEEP_REVIEW_ENGINE_VERSION=1.8.2   (bumped in code; see the note on DISCOVERY_ENGINE_VERSION)
# Parallel review agents; lower it on rate-limited API tiers.
DEEP_REVIEW_MAX_CONCURRENCY=6
DEEP_REVIEW_AGENT_TIMEOUT_SECONDS=900
DEEP_REVIEW_SPECIALIST_MODEL_CALLS=60
DEEP_REVIEW_EXPLORER_MODEL_CALLS=20
DEEP_REVIEW_VERIFIER_MODEL_CALLS=30
DEEP_REVIEW_SYNTHESIZER_MODEL_CALLS=25
DEEP_REVIEW_TOOL_RESULT_TOKEN_LIMIT=12000
DEEP_REVIEW_MAX_OUTPUT_TOKENS=16000
# Stronger Gemini model for verifier + synthesizer only -- Flash alone as
# verifier lets praise and false "unused" findings through; the pro judge
# catches them. Set to an empty value to use GEMINI_MODEL for every role.
DEEP_REVIEW_JUDGE_MODEL=gemini-3.1-pro-preview
